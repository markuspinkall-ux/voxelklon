; Engine configuration file.
; Voxel-Klon (Minecraft-artig) für Godot 4.3+

config_version=5

[application]

config/name="VoxelKlon"
config/description="Ein Minecraft-artiger Voxel-Klon mit Crafting, Monstern, Dörfern und Wasser."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
